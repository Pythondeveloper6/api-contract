{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop",
    "version": "1.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "List",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "Order id",
                        "example": 7
                      },
                      "total": {
                        "type": "number",
                        "format": "double"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "new",
                          "paid",
                          "shipped"
                        ]
                      },
                      "description": {
                        "type": "string",
                        "title": "Customer note"
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "total",
                      "status"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Order id",
            "example": 7
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "paid",
              "shipped"
            ]
          },
          "description": {
            "type": "string",
            "title": "Customer note"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "total",
          "status"
        ]
