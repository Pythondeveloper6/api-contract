{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop",
    "version": "1.0"
  },
  "paths": {
    "/c": {
      "put": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "qty": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[A-Z]+$"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 5
                  },
                  "meta": {
                    "type": "object"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5
                  }
                }
              }
            }
          }
        },
