{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop",
    "version": "1.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "summary": "List"
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "title": "Customer note"
          },
          "status": {
            "type": "string",
            "enum": [
              "shipped",
              "new",
              "paid"
            ]
          },
          "total": {
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "integer",
            "description": "Order id",
            "example": 7
          }
        },
        "required": [
          "status",
          "total",
          "id"
        ]
      }
    }
  }
}
