{
  "openapi": "3.0.3",
  "info": {
    "title": "Shop",
    "version": "2.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "List all orders",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        },
        "description": "Paginated.",
        "x-internal": true,
        "externalDocs": {
          "url": "https://example.com"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Primary key",
            "example": 42
          },
          "total": {
            "type": "number",
            "format": "double",
            "examples": [
              1.5
            ],
            "title": "Total",
            "x-order": 3
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "paid",
              "shipped"
            ]
          },
          "description": {
            "type": "string",
            "title": "Customer note"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "total",
          "status"
        ]
      }
    }
  }
}
