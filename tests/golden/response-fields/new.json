            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "referrer": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "readOnly": true
          }
        },
        "required": [
